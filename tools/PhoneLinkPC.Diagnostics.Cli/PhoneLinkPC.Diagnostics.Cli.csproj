<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(PhoneLinkWindowsTfm)</TargetFramework>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">$(PhoneLinkNeutralTfm)</TargetFramework>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::IsOSPlatform('Windows'))">10.0.18362.0</SupportedOSPlatformVersion>
    <AssemblyName>phonelink-diagnose</AssemblyName>
    <RootNamespace>PhoneLinkPC.Diagnostics.Cli</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PhoneLinkPC.Core\PhoneLinkPC.Core.csproj" />
    <ProjectReference Include="..\..\src\PhoneLinkPC.Infrastructure\PhoneLinkPC.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\PhoneLinkPC.Platform.Linux\PhoneLinkPC.Platform.Linux.csproj" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ProjectReference Include="..\..\src\PhoneLinkPC.Platform.Windows\PhoneLinkPC.Platform.Windows.csproj" />
  </ItemGroup>
</Project>
