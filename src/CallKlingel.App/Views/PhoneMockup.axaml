<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CallKlingel.App.ViewModels"
             x:Class="CallKlingel.App.Views.PhoneMockup"
             x:DataType="vm:StartViewModel">

    <!--
        A drawn handset showing the phone's real state: signal, battery and clock come
        straight from the HFP link. A product photo would be prettier but would also be a
        stock image of someone else's device - this one is actually yours.
    -->
    <Panel Width="210" Height="392">

        <!-- Glow behind the device, brighter while it is connected -->
        <Ellipse Width="240" Height="290" VerticalAlignment="Center"
                 Fill="{StaticResource AccentGlowBrush}"
                 Opacity="{Binding DeviceGlowOpacity}" />

        <!-- Metal frame -->
        <Border Width="186" Height="376" CornerRadius="31"
                Background="{StaticResource BgRaisedBrush}">
            <Border.BoxShadow>0 20 46 0 #70000000</Border.BoxShadow>
        </Border>

        <!-- Inner bezel, a touch lighter so the edge catches light -->
        <Border Width="179" Height="369" CornerRadius="29"
                BorderThickness="1" BorderBrush="#33FFFFFF" Background="#0A0D12" />

        <!-- Side buttons on the right edge -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="9"
                    Margin="0,102,8,0">
            <Border Width="3" Height="31" CornerRadius="2"
                    Background="{StaticResource BgRaisedBrush}" />
            <Border Width="3" Height="52" CornerRadius="2"
                    Background="{StaticResource BgRaisedBrush}" />
        </StackPanel>

        <!-- Screen -->
        <Border Width="167" Height="357" CornerRadius="24" ClipToBounds="True">
            <!--
                A rendered wallpaper rather than XAML paths. Depth is what makes it read as
                a photograph - haze between the ridges, stars fading towards the horizon -
                and flat vector shapes gave two triangles instead. Generated by
                packaging/make-wallpaper.ps1, so nothing has to be licensed or credited.
            -->
            <Border.Background>
                <ImageBrush Source="avares://CallKlingel.App/Assets/wallpaper.png"
                            Stretch="UniformToFill" />
            </Border.Background>

            <Grid RowDefinitions="Auto,*,Auto">

                <!-- The glyph sits over the sky, which is bright at the horizon. This
                     darkens the middle just enough to keep the icon and the name legible
                     without hiding the wallpaper. -->
                <Border Grid.Row="0" Grid.RowSpan="3">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#59000000" Offset="0.42" />
                            <GradientStop Color="#00000000" Offset="0.85" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Status bar, with the phone's own values -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="5"
                      Margin="13,11,13,0">
                    <TextBlock Grid.Column="0" Text="{Binding ClockText}" FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />

                    <!-- Signal bars, filled according to the reported strength -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="1.5"
                                VerticalAlignment="Center">
                        <Border Width="2.5" Height="4" CornerRadius="1" VerticalAlignment="Bottom"
                                Background="{Binding Bar1}" />
                        <Border Width="2.5" Height="6" CornerRadius="1" VerticalAlignment="Bottom"
                                Background="{Binding Bar2}" />
                        <Border Width="2.5" Height="8" CornerRadius="1" VerticalAlignment="Bottom"
                                Background="{Binding Bar3}" />
                        <Border Width="2.5" Height="10" CornerRadius="1" VerticalAlignment="Bottom"
                                Background="{Binding Bar4}" />
                    </StackPanel>

                    <!-- Battery, drawn to scale -->
                    <Panel Grid.Column="3" VerticalAlignment="Center">
                        <Border Width="19" Height="10" CornerRadius="2.5"
                                BorderThickness="1.2" BorderBrush="{StaticResource TextBrush}" />
                        <!-- Hidden until the phone has reported a level: an empty cell is a
                             claim about the battery, and "not measured" is not "empty". -->
                        <Border Width="{Binding BatteryFillWidth}" Height="5" CornerRadius="1"
                                HorizontalAlignment="Left" Margin="2.5,0,0,0"
                                IsVisible="{Binding HasBatteryReading}"
                                Background="{Binding BatteryFillBrush}" />
                        <Border Width="1.6" Height="4" CornerRadius="1"
                                HorizontalAlignment="Right" Margin="0,0,-2.6,0"
                                Background="{StaticResource TextBrush}" />
                    </Panel>
                </Grid>

                <!-- Punch-hole camera -->
                <Ellipse Grid.Row="0" Width="7" Height="7" HorizontalAlignment="Center"
                         VerticalAlignment="Top" Margin="0,9,0,0" Fill="#05070B" />

                <!-- Wallpaper content: state of the link -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="16"
                            Margin="0,0,0,26">
                    <Panel HorizontalAlignment="Center" Width="108" Height="108">

                        <!--
                            Three rings of decreasing opacity instead of one hard circle.
                            A single stroke reads as a drawn outline; layered strokes read
                            as light coming off the glyph, which is what makes the screen
                            look switched on rather than printed.
                        -->
                        <Ellipse Width="104" Height="104" StrokeThickness="1"
                                 Stroke="{Binding DeviceGlyphBrush}" Opacity="0.10" />
                        <Ellipse Width="88" Height="88" StrokeThickness="1.5"
                                 Stroke="{Binding DeviceGlyphBrush}" Opacity="0.22" />
                        <Ellipse Width="76" Height="76" StrokeThickness="2"
                                 Stroke="{Binding DeviceGlyphBrush}" Opacity="0.85" />

                        <!-- Filled disc behind the glyph, so the icon never sits on the
                             wallpaper directly and stays readable over the ridge line. -->
                        <Ellipse Width="74" Height="74" Opacity="0.5">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#1A3A6B" Offset="0" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <Path Classes="icon" Width="34" Height="34" StrokeThickness="1.7"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Stroke="{Binding DeviceGlyphBrush}"
                              Data="{StaticResource IconPhone}" />
                    </Panel>

                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding PhoneLabel}" FontSize="14.5"
                                   FontWeight="SemiBold" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="140"
                                   Foreground="{StaticResource TextBrush}" />

                        <!-- State with its own dot, the way a status line reads on a phone -->
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    HorizontalAlignment="Center">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                     Fill="{Binding DeviceGlyphBrush}" />
                            <TextBlock Text="{Binding DeviceStateText}" FontSize="11.5"
                                       Foreground="{Binding DeviceGlyphBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Home indicator -->
                <Border Grid.Row="2" Width="46" Height="3.5" CornerRadius="2"
                        Margin="0,0,0,9" HorizontalAlignment="Center" Background="#3AFFFFFF" />
            </Grid>
        </Border>
    </Panel>
</UserControl>
