<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CallKlingel.App.ViewModels"
             xmlns:models="using:CallKlingel.Core.Models"
             xmlns:views="using:CallKlingel.App.Views"
             x:Class="CallKlingel.App.Views.StartView"
             x:DataType="vm:StartViewModel">

    <ScrollViewer>
        <StackPanel Margin="40,28,40,40" Spacing="28" MaxWidth="820"
                    HorizontalAlignment="Left">

            <!--
                No page title here. The sidebar already carries the product name; repeating
                it wastes the most valuable space on the screen.
                The hero leads with the one thing that matters: is the phone ready.
            -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="36" Margin="0,8,0,0">

                <views:PhoneMockup Grid.Column="0" Classes="heroPhone appearLeft"
                                   VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Spacing="22" VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal" Spacing="16" Classes="appear">

                        <!--
                            One badge, not two swapped by visibility. The circle keeps its
                            place and only changes what it means, so the headline never
                            shifts sideways when the phone connects.

                            A Panel rather than a plain Border: the pulse ring has to be
                            able to grow past the circle without pushing the layout around.
                        -->
                        <Panel Width="56" Height="56" VerticalAlignment="Center">

                            <!-- Soft halo, outside the badge so it can bleed past the edge
                                 without the circle itself losing its crisp outline. -->
                            <Ellipse Width="56" Height="56" Opacity="0.16"
                                     Fill="{StaticResource PositiveBrush}"
                                     IsVisible="{Binding IsPhoneReady}" />

                            <Border Classes="badge" Classes.ready="{Binding IsPhoneReady}"
                                    Width="56" Height="56" CornerRadius="28"
                                    Background="Transparent" ClipToBounds="False">
                                <Panel>
                                    <!-- One ring, expanding outward once and fading -->
                                    <Ellipse Classes="badgePulse" Width="44" Height="44"
                                             Stroke="{StaticResource PositiveBrush}"
                                             StrokeThickness="2"
                                             IsVisible="{Binding IsPhoneReady}" />

                                    <!-- Lit from the top left, so the disc reads as a
                                         surface rather than a flat spot of colour. -->
                                    <Ellipse Width="44" Height="44"
                                             IsVisible="{Binding IsPhoneReady}">
                                        <Ellipse.Fill>
                                            <LinearGradientBrush StartPoint="12%,0%" EndPoint="85%,100%">
                                                <GradientStop Color="{StaticResource PositiveGreen}" Offset="0" />
                                                <GradientStop Color="{StaticResource PositiveDeep}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <!-- Hairline highlight along the top edge: the detail
                                         that separates a button from a coloured circle. -->
                                    <Ellipse Width="44" Height="44" StrokeThickness="1"
                                             Stroke="#38FFFFFF"
                                             IsVisible="{Binding IsPhoneReady}" />

                                    <Ellipse Width="44" Height="44"
                                             Fill="{StaticResource BgRaisedBrush}"
                                             Stroke="{StaticResource StrokeBrush}" StrokeThickness="1"
                                             IsVisible="{Binding !IsPhoneReady}" />

                                    <!-- Stretch="None": the geometry is already drawn at
                                         the right size and position, so nothing scales the
                                         stroke or shifts the mark off centre. -->
                                    <Path Classes="badgeMark" Width="24" Height="24"
                                          Stretch="None"
                                          Stroke="White" StrokeThickness="2.6"
                                          StrokeLineCap="Round" StrokeJoin="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="{StaticResource IconCheckBadge}"
                                          IsVisible="{Binding IsPhoneReady}" />

                                    <Path Classes="icon" Width="22" Height="22"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="{StaticResource IconBluetooth}"
                                          IsVisible="{Binding !IsPhoneReady}" />
                                </Panel>
                            </Border>
                        </Panel>

                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock Classes="display" FontSize="27"
                                       Text="{Binding HeroTitle}" TextWrapping="Wrap" />
                            <TextBlock Classes="body" Text="{Binding HeroSubtitle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Capabilities, as plain rows: no box around every line -->
                    <StackPanel Spacing="16" Margin="4,4,0,0">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Classes="appear d1">
                            <Border Grid.Column="0" Classes="capIcon">
                                <Path Classes="icon accent" Data="{StaticResource IconPhone}" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="h2" Text="Anrufe am PC annehmen" />
                                <TextBlock Classes="muted"
                                           Text="Eingehende Anrufe erscheinen direkt hier." />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Classes="appear d2">
                            <Border Grid.Column="0" Classes="capIcon">
                                <Path Classes="icon accent" Data="{StaticResource IconUser}" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="h2" Text="Namen statt Nummern" />
                                <TextBlock Classes="muted"
                                           Text="Aus deinem lokalen Adressbuch, ohne Cloud." />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Classes="appear d3">
                            <Border Grid.Column="0" Classes="capIcon">
                                <Path Classes="icon accent" Data="{StaticResource IconSpeaker}" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="h2" Text="Ton auf deinen Kopfhörern" />
                                    <!--
                                        Marked, not hidden. The feature belongs on this list -
                                        it is why the project exists - but the audio still goes
                                        through the phone, and a line that quietly claims
                                        otherwise is the one thing this app must not do.
                                    -->
                                    <Border Classes="pill" VerticalAlignment="Center">
                                        <TextBlock Text="in Arbeit" FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource WarnBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Classes="muted"
                                           Text="Annehmen und stummschalten geht schon. Der Ton läuft noch über das Telefon." />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <TextBlock Classes="muted" Text="{Binding ReadyHint}" Margin="4,0,0,0" />
                </StackPanel>
            </Grid>

            <!--
                What the product promises, as a footer. Three short claims, each one a fact
                about how it works rather than a slogan - and each one the reason somebody
                would choose this over the obvious alternatives.
            -->
            <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="30" Classes="appear d3"
                  Margin="2,2,0,0">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9">
                    <Path Classes="icon sm" Stroke="{StaticResource MutedBrush}"
                          VerticalAlignment="Center" Data="{StaticResource IconShield}" />
                    <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center"
                               Text="Lokal, ohne Cloud" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9">
                    <Path Classes="icon sm" Stroke="{StaticResource MutedBrush}"
                          VerticalAlignment="Center" Data="{StaticResource IconBluetooth}" />
                    <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center"
                               Text="Ohne App auf dem Handy" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="9">
                    <Path Classes="icon sm" Stroke="{StaticResource MutedBrush}"
                          VerticalAlignment="Center" Data="{StaticResource IconActivity}" />
                    <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center"
                               Text="Deine SIM, deine Nummer" />
                </StackPanel>
            </Grid>

            <!-- ================= Paired phones ================= -->
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="section" Text="MEIN TELEFON"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="ghost" Padding="12,7" MinHeight="34"
                            Command="{Binding ScanCommand}" IsEnabled="{Binding !IsBusy}"
                            ToolTip.Tip="Geräteliste neu einlesen"
                            AutomationProperties.Name="Geräteliste aktualisieren">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Classes="icon sm" Data="{StaticResource IconRefresh}" />
                            <TextBlock Text="Aktualisieren" VerticalAlignment="Center"
                                       FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Classes="card" Padding="20">
                    <StackPanel Spacing="4">
                        <ProgressBar IsIndeterminate="True" Height="2" CornerRadius="1"
                                     Margin="0,0,0,8"
                                     IsVisible="{Binding IsScanning}"
                                     Foreground="{StaticResource AccentBrush}"
                                     Background="Transparent" />

                        <ItemsControl ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:PhoneDevice">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16"
                                          Margin="0,6">
                                        <Border Grid.Column="0" Width="42" Height="42"
                                                CornerRadius="13"
                                                Background="{StaticResource BgRaisedBrush}">
                                            <Path Classes="icon accent"
                                                  Data="{StaticResource IconPhone}" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="3"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{StaticResource TextBrush}"
                                                       FontWeight="SemiBold" FontSize="14.5" />
                                            <TextBlock Classes="mono" Text="{Binding Id}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                    Spacing="8" VerticalAlignment="Center">
                                            <!--
                                                Bound to the page's own connection state,
                                                not to the row's: the device list is only
                                                rebuilt on a rescan, so a per-row flag goes
                                                stale the moment the link changes.
                                            -->
                                            <StackPanel Orientation="Horizontal" Spacing="7"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding $parent[UserControl].((vm:StartViewModel)DataContext).IsPhoneReady}">
                                                <Ellipse Width="7" Height="7"
                                                         VerticalAlignment="Center"
                                                         Fill="{StaticResource PositiveBrush}" />
                                                <TextBlock Text="Verbunden" FontSize="12"
                                                           Foreground="{StaticResource PositiveBrush}" />
                                            </StackPanel>
                                            <Border CornerRadius="6" Padding="8,4"
                                                    Background="{StaticResource AccentGlowBrush}"
                                                    IsVisible="{Binding SupportsHandsFree}"
                                                    ToolTip.Tip="Freisprech-Profil vorhanden">
                                                <TextBlock Text="HFP" FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="{Binding ScanMessage}"
                                   IsVisible="{Binding ScanMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ================= Pairing ================= -->

            <!--
                Folded away once a phone works. Pairing instructions next to a live
                connection read as "something is still wrong" when nothing is.
            -->
            <Button Classes="ghost" HorizontalAlignment="Left" Padding="14,8"
                    Content="Anderes Telefon koppeln"
                    IsVisible="{Binding ShowPairingToggle}"
                    Command="{Binding ExpandPairingCommand}" />

            <StackPanel Spacing="10" IsVisible="{Binding ShowPairingSection}">
                <TextBlock Classes="section" Text="NEUES TELEFON KOPPELN" />

                <Border Classes="card" Padding="20">
                    <StackPanel Spacing="16">
                        <!--
                            Windows' own pairing dialog is the primary path: it scans longer
                            than an app may and makes the PC discoverable at the same time.
                            The in-app search stays available as a second option.
                        -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                            <Border Grid.Column="0" Width="42" Height="42" CornerRadius="13"
                                    Background="{StaticResource AccentGlowBrush}"
                                    VerticalAlignment="Top">
                                <Path Classes="icon accent" Data="{StaticResource IconBluetooth}" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Classes="h2" Text="Telefon hinzufügen" />
                                <TextBlock Classes="muted" TextWrapping="Wrap" MaxWidth="420"
                                           Text="Öffnet den Kopplungsdialog von Windows. Am Telefon Bluetooth einschalten und die Bluetooth-Seite offen lassen." />
                            </StackPanel>

                            <Button Grid.Column="2" Classes="primary" VerticalAlignment="Center"
                                    Command="{Binding OpenAddDeviceCommand}"
                                    AutomationProperties.Name="Kopplungsdialog öffnen">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <Path Classes="icon sm onDark" Data="{StaticResource IconMore}" />
                                    <TextBlock Text="Telefon hinzufügen" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,4" />

                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                            <TextBlock Grid.Column="0" Classes="muted" FontSize="12"
                                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                                       Text="Alternativ direkt hier suchen. Dauert bis zu einer Minute und findet nicht jedes Telefon." />
                            <Button Grid.Column="1" Classes="ghost" Padding="12,8" MinHeight="38"
                                    FontSize="12" Content="Bluetooth-Einstellungen"
                                    Command="{Binding OpenBluetoothSettingsCommand}" />
                            <Button Grid.Column="2" Classes="ghost" Padding="14,8" MinHeight="38"
                                    FontSize="12" Content="In der App suchen"
                                    Command="{Binding DiscoverCommand}"
                                    IsEnabled="{Binding !IsBusy}" />
                        </Grid>

                        <ProgressBar IsIndeterminate="True" Height="2" CornerRadius="1"
                                     IsVisible="{Binding IsDiscovering}"
                                     Foreground="{StaticResource AccentBrush}"
                                     Background="Transparent" />

                        <ItemsControl ItemsSource="{Binding NewDevices}"
                                      IsVisible="{Binding ShowNewDevices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:PhoneDevice">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16"
                                          Margin="0,6">
                                        <Border Grid.Column="0" Width="42" Height="42"
                                                CornerRadius="13"
                                                Background="{StaticResource BgRaisedBrush}">
                                            <Path Classes="icon" Data="{StaticResource IconPhone}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="3"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{StaticResource TextBrush}"
                                                       FontWeight="SemiBold" FontSize="14.5" />
                                            <TextBlock Classes="mono" Text="{Binding Id}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Classes="primary" Content="Koppeln"
                                                Padding="16,8" MinHeight="38"
                                                Command="{Binding $parent[UserControl].((vm:StartViewModel)DataContext).PairCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="{Binding PairingMessage}"
                                   IsVisible="{Binding PairingMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                        <!--
                            The LE-only bond. It looks like a working pairing everywhere in
                            Windows, so an empty device list is not an answer the user can
                            act on - this states the cause and offers the one step the PC
                            can take on its own.
                        -->
                        <StackPanel Spacing="9" IsVisible="{Binding ShowBondProblem}">
                            <TextBlock Classes="h2" Foreground="{StaticResource NegativeBrush}"
                                       Text="{Binding BondProblemTitle}" />
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       Text="{Binding BondProblemText}" />
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       Text="{Binding BondRemedyText}" />
                            <Button Classes="primary" Content="Alte Kopplung am PC entfernen"
                                    Padding="16,8" MinHeight="38"
                                    HorizontalAlignment="Left"
                                    IsVisible="{Binding CanRemoveStaleBond}"
                                    Command="{Binding RemoveStaleBondCommand}" />
                        </StackPanel>

                        <StackPanel Spacing="9" IsVisible="{Binding ShowPairingHint}">
                            <TextBlock Classes="h2" Text="So koppelst du dein Telefon" />
                            <TextBlock Classes="muted" Text="1.  Am Telefon Bluetooth einschalten und die Bluetooth-Seite offen lassen." />
                            <TextBlock Classes="muted" Text="2.  Oben auf 'Telefon suchen' klicken." />
                            <TextBlock Classes="muted" Text="3.  Gerät auswählen und 'Koppeln' drücken." />
                            <TextBlock Classes="muted" Text="4.  Am Telefon die Kopplung und den Zugriff auf Anrufe bestätigen." />
                        </StackPanel>

                        <StackPanel Spacing="7" IsVisible="{Binding ShowNoHfpHint}">
                            <TextBlock Classes="h2" Foreground="{StaticResource WarnBrush}"
                                       Text="Gekoppelt, aber ohne Telefonie-Profil" />
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       Text="Kein Gerät meldet das Freisprech-Profil (HFP). In den Bluetooth-Geräteoptionen 'Telefonie/Freisprechen' aktivieren und am Telefon den Zugriff auf Anrufe erlauben." />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Quiet footer, no boxes -->
            <StackPanel Orientation="Horizontal" Spacing="28" Margin="2,0,0,0" Opacity="0.8">
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <Path Classes="icon sm" Data="{StaticResource IconShield}" />
                    <TextBlock Classes="muted" FontSize="12" Text="Lokal, ohne Cloud"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <Path Classes="icon sm" Data="{StaticResource IconBluetooth}" />
                    <TextBlock Classes="muted" FontSize="12" Text="Ohne App auf dem Handy"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <Path Classes="icon sm" Data="{StaticResource IconActivity}" />
                    <TextBlock Classes="muted" FontSize="12" Text="Deine SIM, deine Nummer"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
