<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinRT projections only exist on Windows. On Linux this project still compiles
         (as a neutral stub) so the whole solution stays buildable on both platforms. -->
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(PhoneLinkWindowsTfm)</TargetFramework>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">$(PhoneLinkNeutralTfm)</TargetFramework>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::IsOSPlatform('Windows'))">10.0.18362.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhoneLinkPC.Core\PhoneLinkPC.Core.csproj" />
  </ItemGroup>

  <!-- WASAPI is needed to bridge the call audio between the phone and the PC devices. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
  </ItemGroup>

  <!-- WinRT-dependent sources are excluded when building on a non-Windows host. -->
  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <Compile Remove="WinRt\**\*.cs" />
  </ItemGroup>
</Project>
