<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://PhoneLinkPC.App/Styles/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Semantic colour tokens. Components reference these names, never raw hex, so
                the whole interface can be retuned in one place.

                Contrast against BgCard: TextPrimary 13.9:1, TextMuted 5.1:1 - both above the
                4.5:1 the guidelines ask for.
            -->
            <Color x:Key="BgDeep">#0B0E14</Color>
            <Color x:Key="BgBase">#0E1219</Color>
            <Color x:Key="BgPanel">#141922</Color>
            <Color x:Key="BgCard">#171C26</Color>
            <Color x:Key="BgRaised">#1E242F</Color>

            <Color x:Key="AccentBlue">#4C8DFF</Color>
            <Color x:Key="AccentBlueDeep">#2563EB</Color>
            <Color x:Key="AccentGlow">#1B2C4A</Color>

            <Color x:Key="PositiveGreen">#2ECC71</Color>
            <Color x:Key="PositiveDeep">#1E9E56</Color>
            <Color x:Key="NegativeRed">#F1454A</Color>
            <Color x:Key="NegativeDeep">#C62B30</Color>
            <Color x:Key="WarnAmber">#F5A524</Color>

            <Color x:Key="TextPrimary">#E9EDF3</Color>
            <Color x:Key="TextSecondary">#A7B0BF</Color>
            <Color x:Key="TextMuted">#78818F</Color>
            <Color x:Key="StrokeSoft">#242B37</Color>

            <SolidColorBrush x:Key="BgDeepBrush" Color="{StaticResource BgDeep}" />
            <SolidColorBrush x:Key="BgBaseBrush" Color="{StaticResource BgBase}" />
            <SolidColorBrush x:Key="BgPanelBrush" Color="{StaticResource BgPanel}" />
            <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCard}" />
            <SolidColorBrush x:Key="BgRaisedBrush" Color="{StaticResource BgRaised}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentBlue}" />
            <SolidColorBrush x:Key="AccentDeepBrush" Color="{StaticResource AccentBlueDeep}" />
            <SolidColorBrush x:Key="AccentGlowBrush" Color="{StaticResource AccentGlow}" />
            <SolidColorBrush x:Key="PositiveBrush" Color="{StaticResource PositiveGreen}" />
            <SolidColorBrush x:Key="PositiveDeepBrush" Color="{StaticResource PositiveDeep}" />
            <SolidColorBrush x:Key="NegativeBrush" Color="{StaticResource NegativeRed}" />
            <SolidColorBrush x:Key="NegativeDeepBrush" Color="{StaticResource NegativeDeep}" />
            <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnAmber}" />
            <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextPrimary}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
            <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource TextMuted}" />
            <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeSoft}" />
            <SolidColorBrush x:Key="GlassBrush" Color="{StaticResource BgPanel}" Opacity="0.82" />

            <!-- Spacing follows a 4/8 rhythm so nothing lands on an arbitrary value. -->
            <x:Double x:Key="IconSm">16</x:Double>
            <x:Double x:Key="IconMd">20</x:Double>
            <x:Double x:Key="IconLg">24</x:Double>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- ============================ Typography ============================ -->

    <Style Selector="TextBlock.display">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="LineHeight" Value="38" />
    </Style>

    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="LineHeight" Value="32" />
    </Style>

    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="LineHeight" Value="24" />
    </Style>

    <Style Selector="TextBlock.body">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="LineHeight" Value="21" />
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>

    <!-- ============================ Surfaces ============================ -->

    <!--
        Cards separate by surface, not by outline. A border around every block is what makes
        an interface look like a wireframe instead of a product.
    -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <!-- Section heading above a group, used instead of wrapping everything in a box. -->
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="Margin" Value="2,0,0,2" />
    </Style>

    <Style Selector="Border.tile">
        <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <!-- A row inside a card: no background at all, just a divider. -->
    <Style Selector="Border.row">
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="0,14" />
    </Style>

    <Style Selector="Border.row.last">
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ============================ Buttons ============================ -->
    <!-- Every button keeps a 44px minimum height for a comfortable target. -->

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="18,11" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentDeepBrush}" />
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="{StaticResource BgRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
    </Style>

    <!-- Round call actions. Scale on press gives feedback without shifting layout. -->
    <Style Selector="Button.round">
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="64" />
        <Setter Property="CornerRadius" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="RenderTransform" Value="scale(1)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.round:pressed">
        <Setter Property="RenderTransform" Value="scale(0.94)" />
    </Style>

    <Style Selector="Button.round.small">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="52" />
        <Setter Property="CornerRadius" Value="26" />
    </Style>

    <Style Selector="Button.accept">
        <Setter Property="Background" Value="{StaticResource PositiveBrush}" />
    </Style>

    <Style Selector="Button.accept:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource PositiveDeepBrush}" />
    </Style>

    <Style Selector="Button.decline">
        <Setter Property="Background" Value="{StaticResource NegativeBrush}" />
    </Style>

    <Style Selector="Button.decline:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource NegativeDeepBrush}" />
    </Style>

    <Style Selector="Button.neutral">
        <Setter Property="Background" Value="{StaticResource BgRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Button.neutral:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
    </Style>

    <!-- Window chrome buttons, sized like the system ones so the window feels native. -->
    <Style Selector="Button.chrome">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.chrome:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BgRaisedBrush}" />
    </Style>

    <Style Selector="Button.chrome.close:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource NegativeBrush}" />
    </Style>

    <!-- ============================ Icons ============================ -->

    <Style Selector="Path.icon">
        <Setter Property="Stroke" Value="{StaticResource MutedBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
    </Style>

    <Style Selector="Path.icon.lg">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
    </Style>

    <Style Selector="Path.icon.sm">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>

    <Style Selector="Path.icon.onDark">
        <Setter Property="Stroke" Value="White" />
    </Style>

    <Style Selector="Path.icon.accent">
        <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
    </Style>

    <Style Selector="Path.icon.positive">
        <Setter Property="Stroke" Value="{StaticResource PositiveBrush}" />
    </Style>

    <!-- ============================ Navigation ============================ -->

    <Style Selector="ListBoxItem.nav">
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="Margin" Value="10,2" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="44" />
    </Style>

    <!-- ============================ Inputs ============================ -->

    <Style Selector="TextBox">
        <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <!-- ==============================================================
         Responsive layout

         Avalonia has no media queries, so MainWindow measures itself and
         puts the result on as classes. These rules are the breakpoints.
         They live here rather than in Motion.axaml because that file is
         dropped entirely when the system asks for reduced motion - and a
         layout that only works while animations are on is a broken layout.
         ============================================================== -->

    <!-- Under 820px the sidebar becomes an icon rail. It never disappears completely:
         losing navigation would strand the user on whatever page they were on. -->
    <Style Selector="Window.rail Border.sidebar">
        <Setter Property="Width" Value="72" />
    </Style>

    <Style Selector="Window.rail :is(Control).railHide">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="Window.rail ListBoxItem">
        <Setter Property="Padding" Value="10,10" />
        <Setter Property="Margin" Value="8,2" />
    </Style>

    <!-- The drawn handset goes first when space runs out: it is illustration, and the
         sidebar already states connection, battery and signal in words. -->
    <Style Selector="Window.rail :is(Control).heroPhone">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Tighter page margins before anything is dropped - worth about 40px of content
         width exactly where the lines start getting cramped. -->
    <Style Selector="Window.narrow :is(Control).page">
        <Setter Property="Margin" Value="22,22,22,28" />
    </Style>
</Styles>
