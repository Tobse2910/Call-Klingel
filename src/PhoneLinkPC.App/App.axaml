<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PhoneLinkPC.App.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://PhoneLinkPC.App/Styles/Theme.axaml" />
        <!-- Removed again at startup when the system asks for reduced motion; see App.axaml.cs -->
        <StyleInclude Source="avares://PhoneLinkPC.App/Styles/Motion.axaml" />
    </Application.Styles>
</Application>
