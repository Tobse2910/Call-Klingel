bin/
obj/
logs/
*.user
.vs/
.idea/
artifacts/

# --- Signing keys -------------------------------------------------------------
# Private keys, never in the repository. Anyone holding these can sign packages that
# look like they came from this project. build-msix.ps1 creates a fresh test
# certificate when none is present, so nothing is lost by keeping them out.
*.pfx
*.snk
*.key
*.p12

# --- Build output ------------------------------------------------------------
# Roughly 400 MB of compiled application, regenerated by build-release.ps1 whenever
# it is needed. Releases are distributed through GitHub releases, not through the
# repository itself.
packaging/publish/
packaging/releases/
packaging/app/payload/
packaging/msix/payload/
packaging/app/*.msix
packaging/msix/*.msix

# --- Local state -------------------------------------------------------------
# Settings, contacts and call history live in the user's profile, but keep these
# patterns in case anything is ever copied here for debugging: they contain phone
# numbers and names.
settings.json
contacts.json
call-history.json
diagnose-report.txt
rfcomm-probe.txt
